{% extends "layout.njk" %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <h1 class="govuk-heading-l">
        {% if heading %}
          {{ heading }}
        {% elif action == 'install' %}
          Install {{ pluginName }} {{ version }}
        {% elif action == 'update' %}
          Update {{ pluginName }} to {{ version }}
        {% else %}
          Uninstall {{ pluginName }}
        {% endif %}
      </h1>

      {% if error or problems.length %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-plugin-plan-problems>
          <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
              {% if error %}
                <p class="govuk-body">{{ error }}</p>
              {% endif %}
              {% if problems.length %}
                <ul class="govuk-list govuk-error-summary__list">
                  {% for problem in problems %}
                    <li>{{ problem }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        </div>

        {% if output %}
          <h2 class="govuk-heading-m">Output</h2>
          {% if outputTruncated %}
            <p class="govuk-body">The output was shortened.</p>
          {% endif %}
          <pre class="govuk-!-font-size-16" data-plugin-output>{{ output }}</pre>
        {% endif %}

        <p class="govuk-body">
          <a class="govuk-link" href="/manage-prototype/plugins">Back to plugins</a>
        </p>
      {% elif noop %}
        <p class="govuk-body">No changes are needed.</p>

        <p class="govuk-body">
          <a class="govuk-link" href="/manage-prototype/plugins">Back to plugins</a>
        </p>
      {% else %}
        <p class="govuk-body">These changes will be made:</p>

        <dl class="govuk-summary-list">
          {% for change in changes %}
            <div class="govuk-summary-list__row" data-plugin-change="{{ change.packageName }}">
              <dt class="govuk-summary-list__key">
                {% if change.action == 'install' %}
                  Install
                {% elif change.action == 'update' %}
                  Update
                {% elif change.action == 'downgrade' %}
                  Downgrade
                {% else %}
                  Uninstall
                {% endif %}
                {{ change.name }}
                {% if change.publisher %}
                  <span class="govuk-caption-m">From {{ change.publisher }}</span>
                {% endif %}
              </dt>
              <dd class="govuk-summary-list__value">
                {% if change.action === 'uninstall' %}
                  <p class="govuk-body">Removes version {{ change.installedVersion }}</p>
                {% elif change.installedVersion %}
                  <p class="govuk-body">Version {{ change.installedVersion }} to {{ change.version }}</p>
                {% else %}
                  <p class="govuk-body">Version {{ change.version }}</p>
                {% endif %}

                {% if change.requiredByNames.length %}
                  <p class="govuk-body">
                    Needed by
                    {% for requiredBy in change.requiredByNames %}
                      {{ requiredBy.name }}{% if requiredBy.publisher %} ({{ requiredBy.publisher }}){% endif %}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                  </p>
                {% endif %}
              </dd>
            </div>
          {% endfor %}
        </dl>

        <form method="post" action="/manage-prototype/plugins/confirm">
          <input type="hidden" name="token" value="{{ token }}">
          <input type="hidden" name="expectedChanges" value="{{ expectedChanges }}">
          <input type="hidden" name="action" value="{{ action }}">
          <input type="hidden" name="packageName" value="{{ packageName }}">

          <div class="govuk-button-group">
            <button class="govuk-button" data-module="govuk-button" data-plugin-confirm>
              Confirm changes
            </button>
            <a class="govuk-link" href="/manage-prototype/plugins">Cancel</a>
          </div>
        </form>
      {% endif %}
    </div>
  </div>

{% endblock %}
