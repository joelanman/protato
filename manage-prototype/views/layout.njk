{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% extends "govuk/template.njk" -%}

{% block pageTitle %}
  {%- if pageName %}{{ pageName }} - {% endif %}Manage your prototype{% if serviceName %} - {{ serviceName }}{% endif %} - GOV.UK Prototype Kit
{% endblock %}

{% block head %}
  <link href="/manage-prototype/public/stylesheets/manage-prototype.css" rel="stylesheet" type="text/css" />
{% endblock %}

{% block header %}
<div class="govuk-header">
    <div class="govuk-header__container govuk-width-container">
        <div class="govuk-header__logo">
            <a href="#" class="govuk-header__homepage-link">
                <span class="govuk-header__product-name">Protato</span>
            </a>
        </div>
    </div>
</div>

  {% if isDevelopment %}
    {{ govukServiceNavigation({
      serviceName: serviceName,
      serviceUrl: '/',
      navigation: [
        {
          text: "Manage your prototype",
          href: "/manage-prototype"
        },
        {
          text: "Templates",
          href: "/manage-prototype/templates"
        },
        {
          text: "Plugins",
          href: "/manage-prototype/plugins"
        }
      ]
    }) }}
  {% elif serviceName and serviceName | trim %}
    {{ govukServiceNavigation({
      serviceName: serviceName,
      serviceUrl: '/'
    }) }}
  {% endif %}
{% endblock %}

{% if isDevelopment %}
  {% set footerItems = [
    {
      href: "/manage-prototype",
      text: "Manage your prototype"
    },
    {
      href: "/manage-prototype/clear-data",
      text: "Clear data"
    }
  ] %}
{% else %}
  {% set footerItems = [
    {
      href: "/manage-prototype/clear-data",
      text: "Clear data"
    }
  ] %}
{% endif %}

{% block footer %}
    <div class="govuk-footer">
        <div class="govuk-width-container">

            <div class="govuk-footer__meta">
                <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">

                    <h2 class="govuk-visually-hidden">Footer links</h2>

                    <ul class="govuk-footer__inline-list">

                        {% for item in footerItems %}

                            <li class="govuk-footer__inline-list-item">
                                <a class="govuk-footer__link" href="{{ item.href}}">
                                    {{ item.text }}
                                </a>
                            </li>

                        {% endfor %}

                    </ul>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block bodyEnd %}
  {% block scripts %}
      <script type="module" src="/manage-prototype/govuk-frontend/dist/govuk/govuk-frontend.min.js"></script>
      <script type="module">
        import { initAll } from '/manage-prototype/govuk-frontend/dist/govuk/govuk-frontend.min.js'
        initAll()
      </script>

      {% block pageScripts %}{% endblock %}

  {% endblock %}
{% endblock %}
