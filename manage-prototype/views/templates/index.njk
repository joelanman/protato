{% extends "layout.njk" %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

      <h1 class="govuk-heading-l">Templates</h1>

      <p class="govuk-body">
        Create pages from templates
      </p>

      {% for plugin in templatesByPlugin %}

        <h2 class="govuk-heading-m">
          {{ plugin.name }}
          {% if plugin.publisher %}
            <span class="govuk-caption-m">From {{ plugin.publisher }}</span>
          {% endif %}
        </h2>

        <dl class="govuk-summary-list">
          {% for template in plugin.templates %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ template.name }}</dt>

              <dd class="govuk-summary-list__actions">
                <ul class="govuk-summary-list__actions-list">
                  <li class="govuk-summary-list__actions-list-item">
                    <a class="govuk-link" href="/manage-prototype/templates/view?packageName={{ plugin.packageName | urlencode }}&amp;templatePath={{ template.path | urlencode }}">
                      View<span class="govuk-visually-hidden"> {{ template.name }}</span>
                    </a>
                  </li>
                  <li class="govuk-summary-list__actions-list-item">
                    <a class="govuk-link" href="/manage-prototype/templates/create?packageName={{ plugin.packageName | urlencode }}&amp;templatePath={{ template.path | urlencode }}">
                      Create<span class="govuk-visually-hidden"> {{ template.name }}</span>
                    </a>
                  </li>
                </ul>
              </dd>
            </div>
          {% endfor %}
        </dl>

      {% endfor %}
    </div>
  </div>
{% endblock %}
