{
	"bin": {
		"protato": "./bin/cli.js"
	},
	"name": "protato",
	"private": true,
	"version": "0.1.0",
	"description": "Quickly make interactive, accessible and realistic prototypes.",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"build": "node manage-prototype/build.js",
		"build:manage": "node manage-prototype/build.js",
		"compare:loc": "node scripts/compare-lines-of-code.js",
		"dev": "cd starter && npm run dev",
		"install:starter": "node scripts/install-starter.js",
		"start": "cd starter && npm start",
		"test:browser": "playwright test",
		"test:browser:headed": "playwright test --headed",
		"test:browser:ui": "playwright test --ui",
		"lint": "npx @biomejs/biome check",
		"lint:fix": "npx @biomejs/biome check --write",
		"test": "npm run test:unit && npm run test:end && npm run lint",
		"test:all": "npm test && npm run test:browser",
		"test:unit": "npx vitest run --config vitest.unit.config.js",
		"test:end": "npx vitest run --config vitest.end.config.js",
		"test:coverage": "npx vitest run --config vitest.unit.config.js --coverage"
	},
	"author": "Joe Lanman",
	"license": "ISC",
	"dependencies": {
		"body-parser": "^2.4.0",
		"chokidar": "^6.0.0",
		"commander": "14.0.0",
		"cookie-parser": "^1.4.7",
		"cross-spawn": "^7.0.6",
		"csrf-csrf": "^4.0.3",
		"express": "5.3.0",
		"express-session": "1.19.0",
		"govuk-frontend": "^6.6.0",
		"nunjucks": "^3.2.4",
		"radash": "12.1.1",
		"sass": "1.105.1",
		"semver": "7.8.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.64.1",
		"@vitest/coverage-v8": "5.0.3",
		"supertest": "7.3.1",
		"vitest": "5.0.3"
	},
	"overrides": {
		"chokidar": "$chokidar"
	}
}
