{
	"bin": {
		"protato": "./bin/cli.js"
	},
	"name": "protato",
	"private": true,
	"version": "0.1.0",
	"description": "Prototype websites",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"build": "node manage-prototype/build.js",
		"build:manage": "node manage-prototype/build.js",
		"dev": "cd starter && npm run dev",
		"start": "cd starter && npm start",
		"lint": "npx @biomejs/biome check",
		"lint:fix": "npx @biomejs/biome check --write",
		"test": "npm run test:unit && npm run test:end && npm run lint",
		"test:unit": "npx vitest run --config vitest.unit.config.js",
		"test:end": "npx vitest run --config vitest.end.config.js",
		"test:coverage": "npx vitest run --config vitest.unit.config.js --coverage"
	},
	"author": "Joe Lanman",
	"license": "ISC",
	"dependencies": {
		"body-parser": "2.3.0",
		"chokidar": "4.0.3",
		"commander": "14.0.0",
		"express": "5.3.0",
		"express-session": "1.19.0",
		"govuk-frontend": "5.11.2",
		"nunjucks": "3.2.4",
		"radash": "12.1.1",
		"sass": "1.105.1",
		"semver": "7.8.5",
		"tar-stream": "3.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@vitest/coverage-v8": "5.0.3",
		"supertest": "7.3.1",
		"vitest": "5.0.3"
	},
	"overrides": {
		"nunjucks": {
			"chokidar": "4.0.3"
		}
	}
}
